    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dot-protocol/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "license": "MIT"
}
