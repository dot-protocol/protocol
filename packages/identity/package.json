{
  "name": "@dot-protocol/identity",
  "version": "1.0.0",
  "description": "DOT Protocol identity — keypair + genesis DOT + export/import.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
