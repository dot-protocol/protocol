{
  "name": "dot-protocol-kin",
  "version": "0.1.0",
  "description": "DOT MCP server — 11 tools for AI agents. Boot, create, sign, chain, encrypt, seal, verify.",
  "type": "module",
  "bin": {
    "dot-kin": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dot-protocol",
    "mcp",
    "kin",
    "ai-agent"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "dot-protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsdown": "^0.12.0",
    "vitest": "^3.0.0"
  }
}
