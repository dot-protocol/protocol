{
  "name": "@dot-protocol/kin",
  "version": "0.1.0",
  "description": "Kin MCP server — DOT protocol tools for any MCP-compatible AI agent.",
  "type": "module",
  "bin": {
    "dot-kin": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsdown",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["dot-protocol", "mcp", "kin", "ai-agent"],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@dot-protocol/engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsdown": "^0.12.0",
    "vitest": "^3.0.0"
  }
}
